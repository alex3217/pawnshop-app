APP_NAME=pawnloop-api
APP_ENV=staging
NODE_ENV=staging
PORT=10000
PAWN_PORT=6003
DATABASE_URL=postgresql://synthetic_user:synthetic_password@staging-db.invalid/pawnloop_staging?sslmode=require
STAGING_DATABASE_HOST=staging-db.invalid
JWT_SECRET=synthetic-jwt-secret-at-least-thirty-two-characters
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=synthetic-encryption-key-at-least-thirty-two-characters
FRONTEND_URL=https://web.staging.invalid
WEB_URL=https://web.staging.invalid
CORS_ORIGIN=https://web.staging.invalid
CORS_ORIGINS=https://web.staging.invalid,https://admin.staging.invalid
CORS_ALLOW_PAWNLOOP_PREVIEWS=true
INVITE_ONLY_REGISTRATION_ENABLED=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_RATE_LIMIT_SENSITIVE_IP_MAX=10
AUTH_RATE_LIMIT_IDENTIFIER_MAX=20
AUTH_RATE_LIMIT_COMBINED_MAX=5
TRUST_PROXY=1
SMTP_HOST=smtp.staging.invalid
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=PawnLoop Staging <no-reply@staging.invalid>
STRIPE_SECRET_KEY=sk_test_synthetic_staging_key
STRIPE_PUBLISHABLE_KEY=pk_test_synthetic_staging_key
STRIPE_WEBHOOK_SECRET=whsec_synthetic_platform_webhook
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_synthetic_connect_webhook
STRIPE_PRICE_PRO=price_synthetic_pro
STRIPE_PRICE_PREMIUM=price_synthetic_premium
STRIPE_PRICE_ULTRA=price_synthetic_ultra
STRIPE_PRICE_BUYER_PLUS=price_synthetic_buyer_plus
STRIPE_PRICE_BUYER_PREMIUM=price_synthetic_buyer_premium
STRIPE_PRICE_BUYER_ULTRA=price_synthetic_buyer_ultra
AUCTION_SCHEDULER_ENABLED=false
AUCTION_SCHEDULER_INTERVAL_MS=5000
AUCTION_SCHEDULER_BATCH_SIZE=50
MARKETPLACE_RESERVATION_SCHEDULER_ENABLED=false
MARKETPLACE_RESERVATION_SCHEDULER_INTERVAL_MS=60000
MARKETPLACE_RESERVATION_SCHEDULER_BATCH_SIZE=50
MARKETPLACE_RESERVATION_TTL_MINUTES=30
READINESS_TIMEOUT_MS=5000
