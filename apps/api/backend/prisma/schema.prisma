model SellerBalanceLedger {
  id                       String                  @id @default(cuid())
  settlementId             String?
  marketplaceTransactionId String?
  payoutId                 String?
  refundId                 String?                 @unique
  disputeId                String?
  idempotencyKey           String?                 @unique
  sellerUserId             String
  shopId                   String
  type                     SellerLedgerEntryType
  status                   SellerLedgerEntryStatus @default(PENDING)
  amountCents              Int
  currency                 String                  @default("USD")
  availableAt              DateTime?
  description              String?
  metadata                 Json?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  settlement             Settlement?             @relation("SettlementSellerLedgerEntries", fields: [settlementId], references: [id], onDelete: Restrict)
  marketplaceTransaction MarketplaceTransaction? @relation(fields: [marketplaceTransactionId], references: [id], onDelete: Restrict)
  payout                 SellerPayout?           @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  refund                 StripeRefund?           @relation(fields: [refundId], references: [id], onDelete: Restrict)
  dispute                StripeDispute?          @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  seller                 User                    @relation("SellerBalanceLedgerUser", fields: [sellerUserId], references: [id], onDelete: Restrict)
  shop                   PawnShop                @relation("SellerBalanceLedgerShop", fields: [shopId], references: [id], onDelete: Restrict)

  @@index([sellerUserId, status, createdAt])
  @@index([shopId, status, createdAt])
  @@index([payoutId])
  @@index([settlementId])
  @@index([marketplaceTransactionId])
  @@index([disputeId])
  @@index([type, status])
}

model SellerPayout {
  id                 String             @id @default(cuid())
  sellerUserId       String
  shopId             String
  status             SellerPayoutStatus @default(PENDING)
  amountCents        Int
  currency           String             @default("USD")
  provider           String?
  providerPayoutId   String?            @unique
  idempotencyKey     String             @unique
  requestedByUserId  String?
  requestNote        String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  cancellationReason String?
  stripeTransferId   String?            @unique
  failureCode        String?
  failureMessage     String?
  requestedAt        DateTime           @default(now())
  processingAt       DateTime?
  paidAt             DateTime?
  failedAt           DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  seller        User                  @relation("SellerPayoutUser", fields: [sellerUserId], references: [id], onDelete: Restrict)
  shop          PawnShop              @relation("SellerPayoutShop", fields: [shopId], references: [id], onDelete: Restrict)
  ledgerEntries SellerBalanceLedger[]

  @@index([sellerUserId, status, createdAt])
  @@index([shopId, status, createdAt])
  @@index([status, requestedAt])
  @@index([requestedByUserId, requestedAt])
  @@index([createdAt])
}

model StripeConnectedAccountPayout {
  id                       String    @id @default(cuid())
  stripePayoutId           String    @unique
  stripeAccountId          String
  shopId                   String?
  amountCents              Int
  currency                 String
  status                   String
  arrivalDate              DateTime?
  failureCode              String?
  failureMessage           String?
  payoutMethod             String?
  payoutType               String?
  stripeCreatedAt          DateTime?
  lastStripeEventId        String
  lastStripeEventCreatedAt DateTime
  paidAt                   DateTime?
  failedAt                 DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  shop   PawnShop?                           @relation(fields: [shopId], references: [id], onDelete: SetNull)
  events StripeConnectedAccountPayoutEvent[]

  @@index([stripeAccountId, status, arrivalDate])
  @@index([shopId, createdAt])
  @@index([status, arrivalDate])
}

model StripeConnectedAccountPayoutEvent {
  id                   String   @id @default(cuid())
  stripeEventId        String   @unique
  stripePayoutRecordId String
  eventType            String
  stripeEventCreatedAt DateTime
  createdAt            DateTime @default(now())

  payout StripeConnectedAccountPayout @relation(fields: [stripePayoutRecordId], references: [id], onDelete: Restrict)

  @@index([stripePayoutRecordId, stripeEventCreatedAt])
}

model PlatformSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("PlatformSettingUpdatedByUser", fields: [updatedByUserId], references: [id])

  @@index([key])
  @@index([updatedByUserId])
}

model PlatformPricingRule {
  id               String    @id @default(cuid())
  key              String    @unique
  label            String
  description      String?
  category         String
  appliesTo        String
  feeType          String
  amountCents      Int?
  percentBps       Int?
  minCents         Int?
  maxCents         Int?
  currency         String    @default("USD")
  status           String    @default("DRAFT")
  stripePriceId    String?
  effectiveStartAt DateTime?
  effectiveEndAt   DateTime?
  metadata         Json?
  createdByUserId  String?
  updatedByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([category, status])
  @@index([appliesTo, status])
  @@index([status, effectiveStartAt])
  @@index([createdAt])
}

model SuperAdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  method     String
  path       String
  routeKey   String?
  targetType String?
  targetId   String?
  statusCode Int?
  success    Boolean  @default(true)
  requestId  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([actorEmail, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([success, createdAt])
}

enum StaffRole {
  SHOP_ADMIN
  SHOP_MANAGER
  SHOP_STAFF
  SHOP_VIEWER
  INVENTORY_MANAGER
  AUCTION_MANAGER
  SALES_ASSOCIATE
  FINANCE_VIEWER
}

enum StaffStatus {
  INVITED
  ACTIVE
  INACTIVE
  ARCHIVED
}

model LegalConsent {
  id             String   @id @default(cuid())
  userId         String
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyVersion])
  @@index([userId, acceptedAt])
}

model BetaInvite {
  id              String                 @id @default(cuid())
  tokenDigest     String                 @unique
  email           String?
  intendedRole    Role?
  cohort          String
  maxUses         Int                    @default(1)
  redeemedCount   Int                    @default(0)
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedByUserId String?
  issuedByUserId  String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  issuedBy        User                   @relation("BetaInviteIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedBy       User?                  @relation("BetaInviteRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  redemptions     BetaInviteRedemption[]

  @@index([cohort, createdAt])
  @@index([email])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([issuedByUserId, createdAt])
}

model BetaInviteRedemption {
  id         String     @id @default(cuid())
  inviteId   String
  userId     String
  redeemedAt DateTime   @default(now())
  invite     BetaInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([inviteId, userId])
  @@index([inviteId, redeemedAt])
  @@index([userId])
}

enum PawnShopLeadBusinessStatus {
  DISCOVERED
  ACTIVE
  INACTIVE
  CLOSED
}

enum PawnShopLeadVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum PawnShopLeadOutreachStatus {
  NOT_CONTACTED
  CONTACTED
  INTERESTED
  DEMO_SCHEDULED
  APPLICATION_STARTED
  ONBOARDING
  LIVE
  DECLINED
  DO_NOT_CONTACT
}

enum PawnShopLeadContactType {
  OWNER
  MANAGER
  BUSINESS
  LICENSING
  OTHER
}

enum PawnShopLeadActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS_CHANGE
  FOLLOW_UP
  SUPPRESSION
}

enum PawnShopLeadActivityChannel {
  PHONE
  EMAIL
  IN_PERSON
  VIDEO
  INTERNAL
  OTHER
}

enum PawnShopLeadActivityDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum PawnShopLeadImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PawnShopLeadSourceType {
  MANUAL
  IMPORT
  GOVERNMENT_DATASET
  PUBLIC_WEBSITE
  REFERRAL
  OTHER
}

enum PawnShopLeadCollectionMethod {
  MANUAL_ENTRY
  FILE_IMPORT
  APPROVED_DATASET
  PERMITTED_COLLECTION
  OTHER
}

model PawnShopLead {
  id                    String                         @id @default(cuid())
  businessName          String
  legalName             String?
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  postalCode            String
  country               String                         @default("US")
  latitude              Float?
  longitude             Float?
  phone                 String?
  publicEmail           String?
  website               String?
  facebookUrl           String?
  instagramUrl          String?
  linkedinUrl           String?
  licenseNumber         String?
  licenseAuthority      String?
  licenseStatus         String?
  licenseExpirationDate DateTime?
  sourceType            PawnShopLeadSourceType
  sourceName            String?
  sourceUrl             String?
  sourceRecordId        String?
  businessStatus        PawnShopLeadBusinessStatus     @default(DISCOVERED)
  verificationStatus    PawnShopLeadVerificationStatus @default(UNVERIFIED)
  outreachStatus        PawnShopLeadOutreachStatus     @default(NOT_CONTACTED)
  leadScore             Int                            @default(0)
  assignedUserId        String?
  claimedShopId         String?                        @unique
  doNotContact          Boolean                        @default(false)
  lastVerifiedAt        DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  assignedUser User?                     @relation("PawnShopLeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  claimedShop  PawnShop?                 @relation("PawnShopLeadClaimedShop", fields: [claimedShopId], references: [id], onDelete: SetNull)
  contacts     PawnShopLeadContact[]
  activities   PawnShopLeadActivity[]
  sources      PawnShopLeadSource[]
  suppressions PawnShopLeadSuppression[]

  @@index([businessName])
  @@index([city, state])
  @@index([verificationStatus, outreachStatus])
  @@index([businessStatus, doNotContact])
  @@index([assignedUserId])
  @@index([createdAt])
  @@index([updatedAt])
}

model PawnShopLeadContact {
  id                      String                         @id @default(cuid())
  pawnShopLeadId          String
  name                    String?
  title                   String?
  email                   String?
  phone                   String?
  contactType             PawnShopLeadContactType
  isPublicBusinessContact Boolean                        @default(false)
  verificationStatus      PawnShopLeadVerificationStatus @default(UNVERIFIED)
  isPrimary               Boolean                        @default(false)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  pawnShopLead PawnShopLead @relation(fields: [pawnShopLeadId], references: [id], onDelete: Cascade)

  @@index([pawnShopLeadId, isPrimary])
}

model PawnShopLeadActivity {
  id             String                         @id @default(cuid())
  pawnShopLeadId String
  actorUserId    String?
  activityType   PawnShopLeadActivityType
  channel        PawnShopLeadActivityChannel?
  direction      PawnShopLeadActivityDirection?
  status         String?
  subject        String?
  notes          String?
  occurredAt     DateTime                       @default(now())
  nextFollowUpAt DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  pawnShopLead PawnShopLead @relation(fields: [pawnShopLeadId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation("PawnShopLeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([pawnShopLeadId, occurredAt])
  @@index([nextFollowUpAt])
}

model PawnShopLeadSource {
  id               String                       @id @default(cuid())
  pawnShopLeadId   String
  sourceType       PawnShopLeadSourceType
  sourceName       String
  sourceUrl        String?
  sourceRecordId   String?
  collectionMethod PawnShopLeadCollectionMethod
  rawPayload       Json?
  collectedAt      DateTime                     @default(now())
  lastCheckedAt    DateTime?
  termsReviewedAt  DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  pawnShopLead PawnShopLead @relation(fields: [pawnShopLeadId], references: [id], onDelete: Cascade)

  @@index([pawnShopLeadId, collectedAt])
  @@index([sourceType, sourceRecordId])
}

model PawnShopLeadImport {
  id              String                   @id @default(cuid())
  fileName        String?
  sourceName      String
  sourceType      PawnShopLeadSourceType
  status          PawnShopLeadImportStatus @default(PENDING)
  recordsReceived Int                      @default(0)
  recordsCreated  Int                      @default(0)
  recordsUpdated  Int                      @default(0)
  recordsRejected Int                      @default(0)
  errors          Json?
  startedAt       DateTime                 @default(now())
  completedAt     DateTime?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  createdByUser User? @relation("PawnShopLeadImportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
}

model PawnShopLeadSuppression {
  id              String   @id @default(cuid())
  pawnShopLeadId  String?
  email           String?
  phone           String?
  reason          String
  source          String
  suppressedAt    DateTime @default(now())
  createdByUserId String?
  createdAt       DateTime @default(now())

  pawnShopLead  PawnShopLead? @relation(fields: [pawnShopLeadId], references: [id], onDelete: SetNull)
  createdByUser User?         @relation("PawnShopLeadSuppressionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([pawnShopLeadId])
  @@index([email])
  @@index([phone])
}
