model StripeRefund {
  id                       String                    @id @default(cuid())
  stripeRefundId           String?                   @unique
  idempotencyKey           String                    @unique
  settlementId             String?
  marketplaceTransactionId String?
  paymentIntentId          String
  chargeId                 String?
  buyerUserId              String
  sellerUserId             String
  shopId                   String?
  requestedByUserId        String
  amountCents              Int
  currency                 String                    @default("USD")
  reason                   String
  stripeReason             String?
  status                   StripeRefundStatus        @default(REQUESTED)
  failureCode              String?
  failureMessage           String?
  transferAlreadySent      Boolean                   @default(false)
  recoveryRequirement      StripeRecoveryRequirement @default(NONE)
  requestedAt              DateTime                  @default(now())
  succeededAt              DateTime?
  failedAt                 DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  settlement             Settlement?              @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  marketplaceTransaction MarketplaceTransaction?  @relation(fields: [marketplaceTransactionId], references: [id], onDelete: Restrict)
  buyer                  User                     @relation("StripeRefundBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller                 User                     @relation("StripeRefundSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  shop                   PawnShop?                @relation("StripeRefundShop", fields: [shopId], references: [id], onDelete: SetNull)
  requestedBy            User                     @relation("StripeRefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  ledgerEntry            SellerBalanceLedger?
  auditEvents            StripeRefundAuditEvent[]

  @@index([settlementId, status])
  @@index([marketplaceTransactionId, status])
  @@index([paymentIntentId])
  @@index([chargeId])
  @@index([buyerUserId, createdAt])
  @@index([sellerUserId, createdAt])
  @@index([shopId, createdAt])
}

model StripeRefundAuditEvent {
  id            String   @id @default(cuid())
  refundId      String
  eventType     String
  stripeEventId String?  @unique
  actorUserId   String?
  reason        String?
  snapshot      Json
  createdAt     DateTime @default(now())

  refund StripeRefund @relation(fields: [refundId], references: [id], onDelete: Restrict)
  actor  User?        @relation("StripeRefundAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([refundId, createdAt])
  @@index([actorUserId, createdAt])
}

model StripeDispute {
  id                       String                    @id @default(cuid())
  stripeDisputeId          String                    @unique
  settlementId             String?
  marketplaceTransactionId String?
  paymentIntentId          String?
  chargeId                 String
  buyerUserId              String?
  sellerUserId             String
  shopId                   String?
  amountCents              Int
  currency                 String                    @default("USD")
  reason                   String
  status                   StripeDisputeStatus       @default(UNKNOWN)
  fundsWithdrawn           Boolean                   @default(false)
  fundsReinstated          Boolean                   @default(false)
  transferAlreadySent      Boolean                   @default(false)
  recoveryRequirement      StripeRecoveryRequirement @default(NONE)
  evidenceDueAt            DateTime?
  closedAt                 DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  settlement             Settlement?             @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  marketplaceTransaction MarketplaceTransaction? @relation(fields: [marketplaceTransactionId], references: [id], onDelete: Restrict)
  buyer                  User?                   @relation("StripeDisputeBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  seller                 User                    @relation("StripeDisputeSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  shop                   PawnShop?               @relation("StripeDisputeShop", fields: [shopId], references: [id], onDelete: SetNull)
  ledgerEntries          SellerBalanceLedger[]
  events                 StripeDisputeEvent[]

  @@index([settlementId, status])
  @@index([marketplaceTransactionId, status])
  @@index([paymentIntentId])
  @@index([chargeId])
  @@index([shopId, createdAt])
