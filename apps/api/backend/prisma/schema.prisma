generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String                           @id @default(cuid())
  name                            String
  email                           String                           @unique
  password                        String
  role                            Role                             @default(CONSUMER)
  isActive                        Boolean                          @default(true)
  emailVerifiedAt                 DateTime?
  authVersion                     Int                              @default(0)
  passwordChangedAt               DateTime?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  stripeCustomerId                String?                          @unique
  billingMethodPresent            Boolean                          @default(false)
  billingMethodBrand              String?
  billingMethodLast4              String?
  billingMethodExpMonth           Int?
  billingMethodExpYear            Int?
  billingMethodStatus             String                           @default("NOT_CONFIGURED")
  billingMethodSyncedAt           DateTime?
  Bid                             Bid[]
  bidArchives                     BidArchive[]
  buyerSubscription               BuyerSubscription?
  inventoryImportJobs             InventoryImportJob[]             @relation("UserInventoryImportJobs")
  inventoryIntegrations           InventoryIntegration[]           @relation("UserInventoryIntegrations")
  buyerOffers                     Offer[]                          @relation("OfferBuyer")
  ownerOffers                     Offer[]                          @relation("OfferOwner")
  shops                           PawnShop[]
  savedSearches                   SavedSearch[]                    @relation("UserSavedSearches")
  wonSettlements                  Settlement[]                     @relation("SettlementWinner")
  sellerLedgerEntries             SellerBalanceLedger[]            @relation("SellerBalanceLedgerUser")
  sellerPayouts                   SellerPayout[]                   @relation("SellerPayoutUser")
  watchlistEntries                Watchlist[]                      @relation("UserWatchlist")
  buyerItemSubmissions            BuyerItemSubmission[]            @relation("BuyerItemSubmissions")
  buyerItemSubmissionOffers       BuyerItemSubmissionOffer[]       @relation("BuyerItemSubmissionOfferOwner")
  updatedPlatformSettings         PlatformSetting[]                @relation("PlatformSettingUpdatedByUser")
  staffMemberships                Staff[]                          @relation("StaffUser")
  autoBids                        AutoBid[]
  capturedItemIntakes             ItemIntake[]                     @relation("ItemIntakeCapturedBy")
  customerItemIntakes             ItemIntake[]                     @relation("ItemIntakeCustomer")
  marketplaceListings             MarketplaceListing[]             @relation("MarketplaceListingSeller")
  marketplacePurchases            MarketplaceTransaction[]         @relation("MarketplaceTransactionBuyer")
  marketplaceSales                MarketplaceTransaction[]         @relation("MarketplaceTransactionSeller")
  customerSellFulfillments        CustomerSellFulfillment[]        @relation("CustomerSellFulfillmentCustomer")
  customerSellAcceptedOwner       CustomerSellFulfillment[]        @relation("CustomerSellFulfillmentAcceptedOwner")
  customerSellActions             CustomerSellFulfillment[]        @relation("CustomerSellFulfillmentActor")
  customerSellPaymentReceipts     CustomerSellPayment[]            @relation("CustomerSellPaymentCustomer")
  customerSellPaymentsRecorded    CustomerSellPayment[]            @relation("CustomerSellPaymentRecorder")
  customerSellEvents              MarketplaceTransactionEvent[]    @relation("MarketplaceTransactionEventActor")
  customerSellReceiptCustomer     CustomerSellReceipt[]            @relation("CustomerSellReceiptCustomer")
  customerSellReceiptsCompleted   CustomerSellReceipt[]            @relation("CustomerSellReceiptCompletedBy")
  accountActionTokens             AccountActionToken[]
  legalConsents                   LegalConsent[]
  ownerApplication                OwnerApplication?                @relation("OwnerApplicationOwner")
  reviewedOwnerApplications       OwnerApplication[]               @relation("OwnerApplicationReviewer")
  ownerApplicationResubmissions   OwnerApplicationResubmission[]
  notifications                   Notification[]
  stripeRefundsRequested          StripeRefund[]                   @relation("StripeRefundRequestedBy")
  stripeRefundAuditEvents         StripeRefundAuditEvent[]         @relation("StripeRefundAuditActor")
  stripeRefundsAsBuyer            StripeRefund[]                   @relation("StripeRefundBuyer")
  stripeRefundsAsSeller           StripeRefund[]                   @relation("StripeRefundSeller")
  stripeDisputesAsBuyer           StripeDispute[]                  @relation("StripeDisputeBuyer")
  stripeDisputesAsSeller          StripeDispute[]                  @relation("StripeDisputeSeller")
  stripeSubscriptionBillingEvents StripeSubscriptionBillingEvent[]
  betaInvitesIssued               BetaInvite[]                     @relation("BetaInviteIssuedBy")
  betaInvitesRevoked              BetaInvite[]                     @relation("BetaInviteRevokedBy")
  betaInviteRedemptions           BetaInviteRedemption[]
  assignedPawnShopLeads           PawnShopLead[]                   @relation("PawnShopLeadAssignee")
  pawnShopLeadActivities          PawnShopLeadActivity[]           @relation("PawnShopLeadActivityActor")
  pawnShopLeadImports             PawnShopLeadImport[]             @relation("PawnShopLeadImportCreator")
  pawnShopLeadSuppressions        PawnShopLeadSuppression[]        @relation("PawnShopLeadSuppressionCreator")
  paymentMethodConsents           PaymentMethodConsent[]

  @@index([role, isActive])
  @@index([createdAt])
}

model PaymentMethodConsent {
  id                String   @id @default(cuid())
  idempotencyKey    String   @unique
  userId            String
  shopId            String?
  stripeCustomerId  String
  stripeCheckoutSessionId String? @unique
  stripeSetupIntentId String? @unique
  stripeMandateId   String?
  paymentMethodId   String?
  termsVersion      String
  consentText       String
  consentedAt       DateTime
  ipAddress         String?
  userAgent         String?
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([shopId, createdAt])
  @@index([stripeCustomerId, status])
}

enum OwnerApplicationStatus {
  PENDING
  IN_REVIEW
  INFORMATION_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

model OwnerApplication {
  id              String                 @id @default(cuid())
  ownerId         String                 @unique
  status          OwnerApplicationStatus @default(PENDING)
  businessName    String?
  businessType    String?
  businessEmail   String?
  businessPhone   String?
  websiteUrl      String?
  businessAddress Json?
  licenseNumber   String?
  licenseState    String?
  applicationData Json?
  submittedAt     DateTime               @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  decisionReason  String?
  adminNotes      String?
  statusChangedAt DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  owner         User                            @relation("OwnerApplicationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  reviewedBy    User?                           @relation("OwnerApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewHistory OwnerApplicationReviewHistory[]
  resubmissions OwnerApplicationResubmission[]

  @@index([status, createdAt])
  @@index([reviewedById])
}

model OwnerApplicationResubmission {
  id                 String                 @id @default(cuid())
  ownerApplicationId String
  ownerId            String
  previousStatus     OwnerApplicationStatus
  newStatus          OwnerApplicationStatus
  submittedAt        DateTime               @default(now())

  ownerApplication OwnerApplication @relation(fields: [ownerApplicationId], references: [id], onDelete: Cascade)
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerApplicationId, submittedAt, id])
  @@index([ownerId, submittedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  actionUrl String?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model OwnerApplicationReviewHistory {
  id                 String                 @id @default(cuid())
  ownerApplicationId String
  previousStatus     OwnerApplicationStatus
  newStatus          OwnerApplicationStatus
  decisionReason     String?
  adminNotes         String?
  reviewerId         String
  reviewerName       String?
  reviewerEmail      String?
  reviewerRole       Role?
  reviewedAt         DateTime               @default(now())

  ownerApplication OwnerApplication @relation(fields: [ownerApplicationId], references: [id], onDelete: Cascade)

  @@index([ownerApplicationId, reviewedAt, id])
  @@index([reviewerId, reviewedAt])
}

model AccountActionToken {
  id          String                    @id @default(cuid())
  userId      String
  purpose     AccountActionTokenPurpose
  tokenDigest String                    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime                  @default(now())
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([purpose, expiresAt])
}

model BuyerSubscription {
  id                      String                  @id @default(cuid())
  userId                  String                  @unique
  plan                    BuyerSubscriptionPlan   @default(FREE)
  status                  BuyerSubscriptionStatus @default(ACTIVE)
  billingInterval         BillingInterval?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  startedAt               DateTime?
  canceledAt              DateTime?
  trialEndsAt             DateTime?
  cancelAtPeriodEnd       Boolean                 @default(false)
  stripeCustomerId        String?
  stripeSubscriptionId    String?                 @unique
  stripePriceId           String?
  stripeLatestInvoiceId   String?
  stripeCheckoutSessionId String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  user                    User                    @relation(fields: [userId], references: [id])

  @@index([plan, status])
  @@index([status, currentPeriodEnd])
  @@index([createdAt])
}

model PawnShop {
  id                                 String                           @id @default(cuid())
  name                               String
  address                            String?
  city                               String?
  state                              String?
  zip                                String?
  latitude                           Float?
  longitude                          Float?
  phone                              String?
  description                        String?
  hours                              String?
  ownerId                            String
  isDeleted                          Boolean                          @default(false)
  createdAt                          DateTime                         @default(now())
  updatedAt                          DateTime                         @updatedAt
  onboardingCompletedAt              DateTime?
  cancelAtPeriodEnd                  Boolean                          @default(false)
  stripeCustomerId                   String?
  billingMethodPresent               Boolean                          @default(false)
  billingMethodBrand                 String?
  billingMethodLast4                 String?
  billingMethodExpMonth              Int?
  billingMethodExpYear               Int?
  billingMethodStatus                String                           @default("NOT_CONFIGURED")
  billingMethodSyncedAt              DateTime?
  stripeSubscriptionId               String?                          @unique
  stripeConnectAccountId             String?                          @unique
  stripeConnectDetailsSubmitted      Boolean                          @default(false)
  stripeConnectChargesEnabled        Boolean                          @default(false)
  stripeConnectPayoutsEnabled        Boolean                          @default(false)
  stripeConnectOnboardingCompletedAt DateTime?
  stripeConnectStatusUpdatedAt       DateTime?
  subscriptionCurrentPeriodEnd       DateTime?
  subscriptionPlan                   String                           @default("FREE")
  subscriptionStatus                 String                           @default("ACTIVE")
  stripeCheckoutSessionId            String?
  stripeLatestInvoiceId              String?
  stripePriceId                      String?
  subscriptionBillingInterval        BillingInterval?
  subscriptionCanceledAt             DateTime?
  subscriptionStartedAt              DateTime?
  stripeSubscriptionEventCreatedAt   DateTime?
  stripeSubscriptionEventId          String?
  stripeSubscriptionEventType        String?
  auctions                           Auction[]
  inventoryImportJobs                InventoryImportJob[]             @relation("ShopInventoryImportJobs")
  inventoryIntegrations              InventoryIntegration[]           @relation("ShopInventoryIntegrations")
  items                              Item[]
  staffMembers                       Staff[]                          @relation("ShopStaffMembers")
  owner                              User                             @relation(fields: [ownerId], references: [id])
  inventorySyncJobs                  InventorySyncJob[]
  buyerItemSubmissionOffers          BuyerItemSubmissionOffer[]       @relation("BuyerItemSubmissionOfferShop")
  itemIntakes                        ItemIntake[]                     @relation("ShopItemIntakes")
  sellerLedgerEntries                SellerBalanceLedger[]            @relation("SellerBalanceLedgerShop")
  sellerPayouts                      SellerPayout[]                   @relation("SellerPayoutShop")
  stripeConnectedAccountPayouts      StripeConnectedAccountPayout[]
  marketplaceListings                MarketplaceListing[]             @relation("MarketplaceListingShop")
  marketplaceBuyerTransactions       MarketplaceTransaction[]         @relation("MarketplaceTransactionBuyerShop")
  marketplaceSellerTransactions      MarketplaceTransaction[]         @relation("MarketplaceTransactionSellerShop")
  customerSellFulfillments           CustomerSellFulfillment[]
  customerSellPayments               CustomerSellPayment[]
  customerSellReceipts               CustomerSellReceipt[]
  stripeRefunds                      StripeRefund[]                   @relation("StripeRefundShop")
  claimedGrowthLeads                 PawnShopLead[]                   @relation("PawnShopLeadClaimedShop")
  stripeDisputes                     StripeDispute[]                  @relation("StripeDisputeShop")
  stripeSubscriptionBillingEvents    StripeSubscriptionBillingEvent[]

  @@index([ownerId, isDeleted])
  @@index([isDeleted, createdAt])
  @@index([subscriptionPlan, subscriptionStatus])
  @@index([subscriptionStatus, subscriptionCurrentPeriodEnd])
}

model StripeSubscriptionBillingEvent {
  id                   String   @id @default(cuid())
  stripeEventId        String   @unique
  eventType            String
  stripeEventCreatedAt DateTime
  shopId               String
  ownerUserId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeInvoiceId      String?
  applied              Boolean  @default(false)
  previousState        Json
  resultingState       Json
  payload              Json
  createdAt            DateTime @default(now())
  shop                 PawnShop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  owner                User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([shopId, stripeEventCreatedAt, id])
  @@index([stripeSubscriptionId, stripeEventCreatedAt])
  @@index([stripeInvoiceId])
  @@index([ownerUserId, createdAt])
}

model Staff {
  id          String      @id @default(cuid())
  shopId      String
  userId      String?
  email       String
  name        String?
  phone       String?
  role        StaffRole   @default(SHOP_STAFF)
  status      StaffStatus @default(INVITED)
  permissions String[]    @default([])
  invitedAt   DateTime    @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  shop        PawnShop    @relation("ShopStaffMembers", fields: [shopId], references: [id], onDelete: Cascade)
  user        User?       @relation("StaffUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([shopId, email])
  @@index([shopId, status])
  @@index([shopId, role])
  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model Item {
  id                      String                   @id @default(cuid())
  pawnShopId              String
  title                   String
  description             String?
  price                   Decimal                  @db.Decimal(10, 2)
  images                  String[]
  category                String?
  condition               String?
  status                  ItemStatus               @default(AVAILABLE)
  isDeleted               Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  currency                String                   @default("USD")
  auction                 Auction?
  inquiries               Inquiry[]
  shop                    PawnShop                 @relation(fields: [pawnShopId], references: [id])
  offers                  Offer[]
  watchlistEntries        Watchlist[]              @relation("ItemWatchlist")
  marketplaceListings     MarketplaceListing[]
  customerSellAcquisition CustomerSellFulfillment? @relation("CustomerSellAcquiredItem")

  @@index([pawnShopId, status, isDeleted])
  @@index([category, status, isDeleted])
  @@index([createdAt])
}

model Inquiry {
  id            String   @id @default(cuid())
  itemId        String
  consumerEmail String
  message       String
  createdAt     DateTime @default(now())
  item          Item     @relation(fields: [itemId], references: [id])

  @@index([itemId, createdAt])
  @@index([consumerEmail])
}

model Auction {
  id                 String        @id @default(cuid())
  itemId             String        @unique
  shopId             String
  status             AuctionStatus @default(SCHEDULED)
  startingPrice      Decimal       @db.Decimal(10, 2)
  minIncrement       Decimal       @db.Decimal(10, 2)
  reservePrice       Decimal?      @db.Decimal(10, 2)
  buyItNowPrice      Decimal?      @db.Decimal(10, 2)
  startsAt           DateTime
  endsAt             DateTime
  antiSnipeWindowSec Int           @default(120)
  extendedEndsAt     DateTime?
  currentPrice       Decimal       @db.Decimal(10, 2)
  version            Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  ownerReviewedAt    DateTime?
  ownerReviewedById  String?
  item               Item          @relation(fields: [itemId], references: [id])
  shop               PawnShop      @relation(fields: [shopId], references: [id])
  bids               Bid[]
  settlement         Settlement?
  autoBids           AutoBid[]

  @@index([status, startsAt])
  @@index([status, endsAt])
  @@index([shopId, status])
  @@index([ownerReviewedAt])
  @@index([ownerReviewedById])
  @@index([createdAt])
}

model AutoBid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  maxAmount Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([auctionId, userId])
  @@index([auctionId, maxAmount])
}

model Bid {
  id        String       @id @default(cuid())
  auctionId String
  userId    String
  amount    Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now())
  auction   Auction      @relation(fields: [auctionId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  archives  BidArchive[]

  @@index([auctionId, amount])
  @@index([auctionId, createdAt])
  @@index([userId, auctionId])
}

model BidArchive {
  id         String    @id @default(cuid())
  userId     String
  bidId      String
  archivedAt DateTime? @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bid        Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@unique([userId, bidId])
  @@index([userId, archivedAt])
  @@index([bidId])
}

model Settlement {
  id                  String                @id @default(cuid())
  auctionId           String?               @unique
  offerId             String?               @unique
  winnerUserId        String
  finalPrice          Decimal               @db.Decimal(10, 2)
  status              SettlementStatus      @default(PENDING)
  stripePaymentIntent String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  chargedAt           DateTime?
  currency            String                @default("USD")
  failedAt            DateTime?
  failureMessage      String?
  grossAmountCents    Int?
  platformFeeCents    Int?
  sellerNetCents      Int?
  processorFeeCents   Int?
  platformNetCents    Int?
  sellerPlanCode      String?
  transactionType     String?
  pricingRuleSnapshot Json?
  revenueCalculatedAt DateTime?
  fulfillmentStatus   FulfillmentStatus     @default(PAYMENT_PENDING)
  fulfillmentNote     String?
  fulfilledAt         DateTime?
  auction             Auction?              @relation(fields: [auctionId], references: [id])
  offer               Offer?                @relation(fields: [offerId], references: [id])
  winner              User                  @relation("SettlementWinner", fields: [winnerUserId], references: [id])
  sellerLedgerEntries SellerBalanceLedger[] @relation("SettlementSellerLedgerEntries")
  stripeRefunds       StripeRefund[]
  stripeDisputes      StripeDispute[]

  @@index([winnerUserId, status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([offerId])
}

model Offer {
  id             String      @id @default(cuid())
  itemId         String
  buyerId        String
  ownerId        String
  amount         Decimal     @db.Decimal(10, 2)
  message        String?
  status         OfferStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  counterAmount  Decimal?    @db.Decimal(10, 2)
  counterMessage String?
  respondedAt    DateTime?
  buyer          User        @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  item           Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  owner          User        @relation("OfferOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  settlement     Settlement?

  @@index([buyerId, createdAt])
  @@index([ownerId, createdAt])
  @@index([itemId, status])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  item      Item     @relation("ItemWatchlist", fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation("UserWatchlist", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, createdAt])
  @@index([itemId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation("UserSavedSearches", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BuyerItemSubmission {
  id             String    @id @default(cuid())
  buyerId        String
  title          String
  description    String?
  category       String?
  condition      String?
  estimatedValue Decimal?  @db.Decimal(10, 2)
  images         String[]  @default([])
  intent         String    @default("PAWN_OFFERS")
  radiusMiles    Int       @default(25)
  status         String    @default("SUBMITTED")
  reviewMessage  String?
  reviewedAt     DateTime?
  reviewedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  buyer                   User                       @relation("BuyerItemSubmissions", fields: [buyerId], references: [id], onDelete: Cascade)
  offers                  BuyerItemSubmissionOffer[] @relation("BuyerItemSubmissionOffers")
  itemIntake              ItemIntake?                @relation("ItemIntakeLinkedSubmission")
  marketplaceTransaction  MarketplaceTransaction?    @relation("MarketplaceTransactionSubmission")
  customerSellFulfillment CustomerSellFulfillment?

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([intent, status])
}

model BuyerItemSubmissionOffer {
  id           String    @id @default(cuid())
  submissionId String
  shopId       String
  ownerId      String
  amount       Decimal   @db.Decimal(10, 2)
  message      String?
  status       String    @default("PENDING")
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submission              BuyerItemSubmission      @relation("BuyerItemSubmissionOffers", fields: [submissionId], references: [id], onDelete: Cascade)
  shop                    PawnShop                 @relation("BuyerItemSubmissionOfferShop", fields: [shopId], references: [id], onDelete: Cascade)
  owner                   User                     @relation("BuyerItemSubmissionOfferOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  marketplaceTransaction  MarketplaceTransaction?  @relation("MarketplaceTransactionSubmissionOffer")
  customerSellFulfillment CustomerSellFulfillment?

  @@unique([id, submissionId], map: "BuyerItemSubmissionOffer_id_submissionId_key")
  @@index([submissionId, status])
  @@index([shopId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
}

model InventoryImportJob {
  id           String                @id @default(cuid())
  userId       String
  shopId       String
  filename     String
  status       InventoryImportStatus @default(PENDING)
  totalRows    Int                   @default(0)
  successCount Int                   @default(0)
  failedCount  Int                   @default(0)
  errorsJson   Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  shop         PawnShop              @relation("ShopInventoryImportJobs", fields: [shopId], references: [id], onDelete: Cascade)
  user         User                  @relation("UserInventoryImportJobs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([shopId, createdAt])
}

model InventoryIntegration {
  id                   String                     @id @default(cuid())
  ownerId              String
  shopId               String
  name                 String
  type                 String                     @default("CSV_UPLOAD")
  provider             String?
  status               String                     @default("NEEDS_SETUP")
  baseUrl              String?
  inventoryEndpoint    String?
  authType             String                     @default("NONE")
  credentialHint       String?
  encryptedCredentials Json?
  syncFrequencyMinutes Int?
  lastSyncAt           DateTime?
  nextSyncAt           DateTime?
  metadata             Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  owner                User                       @relation("UserInventoryIntegrations", fields: [ownerId], references: [id], onDelete: Cascade)
  shop                 PawnShop                   @relation("ShopInventoryIntegrations", fields: [shopId], references: [id], onDelete: Cascade)
  syncJobs             InventorySyncJob[]
  externalMappings     ExternalInventoryMapping[]
  fieldMappings        InventoryFieldMapping[]
  webhookEvents        IntegrationWebhookEvent[]

  @@index([ownerId, createdAt])
  @@index([shopId, status])
  @@index([type, status])
}

model InventorySyncJob {
  id            String               @id @default(cuid())
  integrationId String
  shopId        String
  status        String               @default("PENDING")
  startedAt     DateTime?
  finishedAt    DateTime?
  createdCount  Int                  @default(0)
  updatedCount  Int                  @default(0)
  skippedCount  Int                  @default(0)
  errorCount    Int                  @default(0)
  errorSummary  Json?
  createdAt     DateTime             @default(now())
