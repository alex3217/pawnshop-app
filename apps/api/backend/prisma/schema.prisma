model MarketplaceListing {
  id                String                   @id @default(cuid())
  itemId            String?
  sellerUserId      String
  sellerShopId      String?
  listingType       MarketplaceListingType
  status            MarketplaceListingStatus @default(DRAFT)
  title             String
  description       String?
  category          String?
  condition         String?
  price             Decimal?                 @db.Decimal(10, 2)
  currency          String                   @default("USD")
  quantity          Int                      @default(1)
  images            String[]                 @default([])
  allowOffers       Boolean                  @default(true)
  pickupAvailable   Boolean                  @default(true)
  shippingAvailable Boolean                  @default(false)
  featuredUntil     DateTime?
  publishedAt       DateTime?
  expiresAt         DateTime?
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  item         Item?                    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  seller       User                     @relation("MarketplaceListingSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  sellerShop   PawnShop?                @relation("MarketplaceListingShop", fields: [sellerShopId], references: [id], onDelete: SetNull)
  transactions MarketplaceTransaction[]
  itemIntake   ItemIntake?              @relation("ItemIntakeLinkedMarketplaceListing")

  @@index([sellerUserId, status, createdAt])
  @@index([sellerShopId, status, createdAt])
  @@index([listingType, status, createdAt])
  @@index([category, status, createdAt])
  @@index([status, publishedAt])
  @@index([featuredUntil])
  @@index([itemId])
}

model MarketplaceTransaction {
  id                String                       @id @default(cuid())
  listingId         String?
  submissionId      String?                      @unique
  submissionOfferId String?                      @unique
  buyerUserId       String
  buyerShopId       String?
  sellerUserId      String
  sellerShopId      String?
  type              MarketplaceTransactionType
  status            MarketplaceTransactionStatus @default(PENDING)
  quantity          Int                          @default(1)
  subtotal          Decimal                      @db.Decimal(10, 2)
  platformFee       Decimal                      @default(0) @db.Decimal(10, 2)
  shippingFee       Decimal                      @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal                      @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal                      @db.Decimal(10, 2)
  currency          String                       @default("USD")
  paymentIntentId   String?                      @unique
  fulfillmentStatus FulfillmentStatus            @default(PAYMENT_PENDING)
  completedAt       DateTime?
  canceledAt        DateTime?
  metadata          Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  listing                 MarketplaceListing?           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  submission              BuyerItemSubmission?          @relation("MarketplaceTransactionSubmission", fields: [submissionId], references: [id], onDelete: Restrict)
  submissionOffer         BuyerItemSubmissionOffer?     @relation("MarketplaceTransactionSubmissionOffer", fields: [submissionOfferId], references: [id], onDelete: Restrict)
  buyer                   User                          @relation("MarketplaceTransactionBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  buyerShop               PawnShop?                     @relation("MarketplaceTransactionBuyerShop", fields: [buyerShopId], references: [id], onDelete: SetNull)
  seller                  User                          @relation("MarketplaceTransactionSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  sellerShop              PawnShop?                     @relation("MarketplaceTransactionSellerShop", fields: [sellerShopId], references: [id], onDelete: SetNull)
  customerSellFulfillment CustomerSellFulfillment?
  customerSellPayment     CustomerSellPayment?
  customerSellReceipt     CustomerSellReceipt?
  events                  MarketplaceTransactionEvent[]
  stripeRefunds           StripeRefund[]
  stripeDisputes          StripeDispute[]
  sellerLedgerEntries     SellerBalanceLedger[]

  @@index([listingId, status])
  @@index([buyerUserId, status, createdAt])
  @@index([sellerUserId, status, createdAt])
  @@index([buyerShopId, status, createdAt])
  @@index([sellerShopId, status, createdAt])
  @@index([type, status, createdAt])
  @@index([createdAt])
}

model CustomerSellFulfillment {
  id                         String                       @id @default(cuid())
  transactionId              String                       @unique
  submissionId               String                       @unique
  submissionOfferId          String                       @unique
  shopId                     String
  customerId                 String
  acceptedShopOwnerId        String
  handoffMethod              CustomerSellHandoffMethod    @default(IN_PERSON)
  lifecycleStatus            CustomerSellLifecycleStatus  @default(AWAITING_HANDOFF)
  inspectionStatus           CustomerSellInspectionStatus @default(NOT_STARTED)
  originalAmount             Decimal                      @db.Decimal(10, 2)
  finalAmount                Decimal?                     @db.Decimal(10, 2)
  currency                   String                       @default("USD")
  observedCondition          String?
  verifiedSerial             String?
  identityVerificationResult CustomerSellIdentityResult   @default(NOT_CHECKED)
  mismatchReason             String?
  rejectionReason            String?
  evidenceUrls               String[]                     @default([])
  itemReceivedAt             DateTime?
  inspectionStartedAt        DateTime?
  inspectedAt                DateTime?
  revisedPriceProposedAt     DateTime?
  customerDecidedAt          DateTime?
  readyForPaymentAt          DateTime?
  paidAt                     DateTime?
  completedAt                DateTime?
  rejectedAt                 DateTime?
  returnedAt                 DateTime?
  customerAcknowledgedAt     DateTime?
  lastActorUserId            String?
  transitionIdempotencyKey   String?                      @unique
  version                    Int                          @default(0)
  intakeId                   String?                      @unique
  inventoryItemId            String?                      @unique
  revenuePolicy              CustomerSellRevenuePolicy    @default(SUBSCRIPTION_COVERED_ZERO_PLATFORM_FEE)
  platformFee                Decimal                      @default(0) @db.Decimal(10, 2)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  transaction       MarketplaceTransaction        @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  submission        BuyerItemSubmission           @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  submissionOffer   BuyerItemSubmissionOffer      @relation(fields: [submissionOfferId], references: [id], onDelete: Restrict)
  shop              PawnShop                      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer          User                          @relation("CustomerSellFulfillmentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  acceptedShopOwner User                          @relation("CustomerSellFulfillmentAcceptedOwner", fields: [acceptedShopOwnerId], references: [id], onDelete: Restrict)
  lastActor         User?                         @relation("CustomerSellFulfillmentActor", fields: [lastActorUserId], references: [id], onDelete: SetNull)
  intake            ItemIntake?                   @relation("CustomerSellFulfillmentIntake", fields: [intakeId], references: [id], onDelete: Restrict)
  inventoryItem     Item?                         @relation("CustomerSellAcquiredItem", fields: [inventoryItemId], references: [id], onDelete: Restrict)
  payment           CustomerSellPayment?
  receipt           CustomerSellReceipt?
  events            MarketplaceTransactionEvent[]

  @@index([shopId, lifecycleStatus, createdAt])
  @@index([customerId, lifecycleStatus, createdAt])
  @@index([transactionId, version])
}

model CustomerSellPayment {
  id               String                     @id @default(cuid())
  transactionId    String                     @unique
  fulfillmentId    String                     @unique
  shopId           String
  customerId       String
  method           CustomerSellPaymentMethod?
  status           CustomerSellPaymentStatus  @default(PENDING)
  amount           Decimal                    @db.Decimal(10, 2)
  currency         String                     @default("USD")
  referenceNumber  String?
  evidenceUrls     String[]                   @default([])
  recordedByUserId String?
  idempotencyKey   String?                    @unique
  recordedAt       DateTime?
  createdAt        DateTime                   @default(now())

  transaction MarketplaceTransaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  fulfillment CustomerSellFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  shop        PawnShop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer    User                    @relation("CustomerSellPaymentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  recordedBy  User?                   @relation("CustomerSellPaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  receipt     CustomerSellReceipt?

  @@index([shopId, status, createdAt])
  @@index([customerId, status, createdAt])
}

model MarketplaceTransactionEvent {
  id             String   @id @default(cuid())
  transactionId  String
  fulfillmentId  String?
  actorUserId    String?
  actorRole      String
  eventType      String
  fromStatus     String?
  toStatus       String?
  idempotencyKey String?  @unique
  data           Json?
  createdAt      DateTime @default(now())

  transaction MarketplaceTransaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  fulfillment CustomerSellFulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  actor       User?                    @relation("MarketplaceTransactionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([transactionId, createdAt])
  @@index([fulfillmentId, createdAt])
  @@index([actorUserId, createdAt])
}

model CustomerSellReceipt {
  id                     String                    @id @default(cuid())
  transactionId          String                    @unique
  fulfillmentId          String                    @unique
  paymentId              String                    @unique
  shopId                 String
  customerId             String
  submissionId           String
  submissionOfferId      String
  inventoryItemId        String                    @unique
  originalAmount         Decimal                   @db.Decimal(10, 2)
  finalAmount            Decimal                   @db.Decimal(10, 2)
  currency               String
  paymentMethod          CustomerSellPaymentMethod
  paymentReferenceNumber String?
  shopName               String
  shopAddress            String?
  customerName           String
  itemTitle              String
  observedCondition      String?
  verifiedSerial         String?
  revenuePolicy          CustomerSellRevenuePolicy
  platformFee            Decimal                   @default(0) @db.Decimal(10, 2)
  completedByUserId      String
  completedByRole        String
  customerAcknowledgedAt DateTime?
  snapshot               Json
  createdAt              DateTime                  @default(now())

  transaction MarketplaceTransaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  fulfillment CustomerSellFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  payment     CustomerSellPayment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  shop        PawnShop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer    User                    @relation("CustomerSellReceiptCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  completedBy User                    @relation("CustomerSellReceiptCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([customerId, createdAt])
}

