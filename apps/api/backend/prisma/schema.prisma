  createdAt     DateTime @default(now())

  dispute StripeDispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
}

enum SellerPayoutStatus {
  PENDING
  PROCESSING
