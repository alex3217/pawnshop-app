# Runtime
APP_NAME=pawnloop-api
NODE_ENV=development
APP_ENV=development
# Required in staging/production: immutable deploy revision or Git SHA.
APP_VERSION=development
PORT=6002
PAWN_PORT=6002
HOST=0.0.0.0
DOTENV_CONFIG_PATH=apps/api/backend/.env.development

# Networking / proxy
TRUST_PROXY=0

# Public authentication abuse controls (process-local; keep enabled in production)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_IP_MAX=30
AUTH_RATE_LIMIT_SENSITIVE_IP_MAX=10
AUTH_RATE_LIMIT_IDENTIFIER_MAX=20
AUTH_RATE_LIMIT_COMBINED_MAX=5

# URLs / CORS
# Required in staging/production; canonical HTTPS API origin without a path.
API_ORIGIN=https://api.pawnloop.com
FRONTEND_URL=https://pawnloop.com
WEB_URL=https://pawnloop.com
CORS_ORIGIN=https://pawnloop.com
CORS_ORIGINS=https://pawnloop.com,https://www.pawnloop.com

# Request limits
JSON_LIMIT=2mb
URLENCODED_LIMIT=2mb

# Durable raster-image uploads (S3-compatible, including Cloudflare R2 or AWS S3)
# Keep disabled until the provider, private credentials, and public asset domain are configured.
DURABLE_UPLOADS_ENABLED=false
UPLOAD_STORAGE_ENDPOINT=https://account-id.r2.cloudflarestorage.com
UPLOAD_STORAGE_REGION=auto
UPLOAD_STORAGE_BUCKET=pawnloop-assets
UPLOAD_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
UPLOAD_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret-key
UPLOAD_STORAGE_PUBLIC_BASE_URL=https://assets.pawnloop.com
UPLOAD_STORAGE_FORCE_PATH_STYLE=false
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_FILES=10
UPLOAD_MAX_AGGREGATE_BYTES=52428800
UPLOAD_MAX_WIDTH=12000
UPLOAD_MAX_HEIGHT=12000
UPLOAD_MAX_PIXELS=40000000
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_USER_MAX=20
UPLOAD_RATE_LIMIT_IP_MAX=60
# Required for distributed upload rate limiting across multiple API instances.
REDIS_URL=redis://localhost:6379
UPLOAD_MAX_CONCURRENT=1
UPLOAD_STORAGE_TIMEOUT_MS=10000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pawnshop?schema=public
# Required only for deployed staging validation; use the exact non-secret database hostname.
STAGING_DATABASE_HOST=staging-db.invalid
# Required only for production validation; exact non-secret hostname from DATABASE_URL.
PRODUCTION_DATABASE_HOST=production-db.invalid

# Health / readiness
READINESS_TIMEOUT_MS=5000

# Auth
JWT_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-long-random-secret
JWT_ACCESS_SECRET=replace-with-long-random-secret
AUTH_SECRET=replace-with-long-random-secret
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=replace-with-long-random-32-byte-secret
# Dormant by default. A dedicated key is required before optional/required mode.
# Generate with: openssl rand -base64 32
MFA_MODE=disabled
MFA_ENCRYPTION_KEY=replace-with-canonical-base64-32-byte-key
MFA_ISSUER=PawnLoop
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_ATTEMPTS=5
MFA_ENROLLMENT_TTL_SECONDS=600
REDIS_URL=redis://127.0.0.1:6379
JWT_EXPIRES_IN=7d
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Explicit public-registration gate. Set true only after issuing beta invites.
INVITE_ONLY_REGISTRATION_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=PawnLoop <no-reply@notifications.pawnloop.com>
RESEND_API_KEY=
RESEND_API_TIMEOUT_MS=10000
# Set EMAIL_PROVIDER=smtp only for environments that intentionally retain SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
# Fail promptly when an SMTP provider cannot be reached (milliseconds).
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=10000

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Signing secret for connected-account events sent to /api/webhooks/stripe/connect.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_DEFAULT_CURRENCY=usd
STRIPE_WEBHOOK_BODY_LIMIT=2mb

# Stripe seller subscription price IDs
STRIPE_PRICE_PRO=price_replace_me
STRIPE_PRICE_PREMIUM=price_replace_me
STRIPE_PRICE_ULTRA=price_replace_me
# Stripe buyer subscription price IDs
STRIPE_PRICE_BUYER_PLUS_MONTHLY=price_replace_me
STRIPE_PRICE_BUYER_PLUS_YEARLY=price_replace_me
STRIPE_PRICE_BUYER_PREMIUM_MONTHLY=price_replace_me
STRIPE_PRICE_BUYER_PREMIUM_YEARLY=price_replace_me
STRIPE_PRICE_BUYER_ULTRA_MONTHLY=price_replace_me
STRIPE_PRICE_BUYER_ULTRA_YEARLY=price_replace_me
STRIPE_CONNECT_ENABLED=false
SELLER_PAYOUT_MINIMUM_CENTS=1000

# Jobs / schedulers
# Deployed values must be exactly true or false. Missing values never enable jobs.
AUCTION_SCHEDULER_ENABLED=false
# disabled: both API scheduler flags false
# api-single-instance: this sole API instance owns one or both enabled schedulers
# dedicated-worker: API flags false; an independently controlled worker owns jobs
SCHEDULER_OWNER=disabled

# OpenAI / AI helpers
OPENAI_API_KEY=sk_replace_me
OPENAI_LISTING_MODEL=gpt-4o-mini
AI_LISTING_ASSISTANT_ENABLED=true
# Server-side provider timeout (1,000-60,000 ms) and authenticated per-user limit.
AI_LISTING_TIMEOUT_MS=15000
AI_LISTING_RATE_LIMIT_WINDOW_MS=60000
AI_LISTING_RATE_LIMIT_MAX=10


AUCTION_SCHEDULER_INTERVAL_MS=5000
AUCTION_SCHEDULER_BATCH_SIZE=50
MARKETPLACE_RESERVATION_SCHEDULER_ENABLED=false
MARKETPLACE_RESERVATION_SCHEDULER_INTERVAL_MS=60000
MARKETPLACE_RESERVATION_SCHEDULER_BATCH_SIZE=50
MARKETPLACE_RESERVATION_TTL_MINUTES=30

# Combined frontend + API hosting
FRONTEND_HOSTS=pawnloop.com,www.pawnloop.com
SERVE_WEB=0
